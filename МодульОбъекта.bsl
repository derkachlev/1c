// Внешняя обработка: получение JSON по HTTPS и разбор ответа.
// Пример использует публичный тестовый API jsonplaceholder.typicode.com.
// Для работы необходимо сетевое подключение с сервера 1С.

Функция ПолучитьТестовыеЗадачи() Экспорт
    Соединение = Новый HTTPСоединение("jsonplaceholder.typicode.com", 443,,,,, Новый ЗащищенноеСоединениеOpenSSL);
    Запрос = Новый HTTPЗапрос("/todos?userId=1");
    Запрос.Заголовки.Вставить("Accept", "application/json");
    Ответ = Соединение.Получить(Запрос);
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Ошибка REST API: HTTP " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    ТекстJSON = Ответ.ПолучитьТелоКакСтроку();
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТекстJSON);
    Попытка
        Данные = ПрочитатьJSON(ЧтениеJSON);
    Исключение
        ЧтениеJSON.Закрыть();
        ВызватьИсключение "Сервис вернул некорректный JSON: " + ОписаниеОшибки();
    КонецПопытки;
    ЧтениеJSON.Закрыть();
    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Идентификатор");
    Таблица.Колонки.Добавить("Заголовок");
    Таблица.Колонки.Добавить("Завершено");
    Для Каждого Задача Из Данные Цикл
        Стр = Таблица.Добавить();
        Стр.Идентификатор = Задача.id;
        Стр.Заголовок = Задача.title;
        Стр.Завершено = Задача.completed;
    КонецЦикла;
    Возврат Таблица;
КонецФункции
